# Umbral — environment template.
#
# PLACEHOLDERS ONLY. Copy to `.env` and fill in real values locally; on Replit put
# them in the Secrets panel. Never commit a real value to this file.

# Postgres. `npm run db:dev` serves an embedded PGlite at this exact URL, so the
# app works offline with no Postgres installed.
#
# `connection_limit=1` is REQUIRED for the local PGlite socket and is not a
# performance tweak: PGlite serves a single connection, so Prisma's default pool
# opens several that collide on prepared-statement names and every other query
# dies with `prepared statement "s0" already exists`. Drop the parameter on
# Replit, where a real Postgres wants a real pool.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1"

# Google OAuth — the only sign-in path. Restricted to @uach.mx server-side.
# Reuse the client from ../uach_english_progress/.env (lines 2 and 3).
# Authorized redirect URI must include:  <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public origin, no trailing slash. Drives the OAuth redirect URI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs the session cookie. Generate: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Salts the export pseudonym (hash of matricula). Changing it breaks the link
# between semesters — set it ONCE and keep it.
EXPORT_PSEUDO_SALT=""

# Admin allowlist, comma-separated. Checked server-side on every admin route.
ADMIN_EMAILS="cavilla@uach.mx"

# Gemini — used ONLY to transcribe spoken answers. Reuse ../uach_english_progress/.env line 15.
# NEVER a `-lite` tier: those reject audio with a 500 that looks like an outage.
GEMINI_API_KEY=""
SPEAKING_ENABLED="true"

# Restricts sign-in to one email domain. Empty disables the check — do not ship empty.
ALLOWED_EMAIL_DOMAIN="uach.mx"
